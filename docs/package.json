{
  "name": "@holotope/docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api": "pnpm run api:core && pnpm run api:three && pnpm run api:physics && pnpm run api:examples",
    "api:core": "typedoc --options typedoc/core.json",
    "api:three": "typedoc --options typedoc/three.json",
    "api:physics": "typedoc --options typedoc/physics.json",
    "api:examples": "node scripts/link-examples.mjs && node scripts/embed-viewers.mjs && node scripts/embed-playground.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "coverage:update": "node scripts/check-coverage.mjs --update",
    "links": "node scripts/check-links.mjs",
    "notation": "node scripts/check-notation.mjs",
    "parameters": "node scripts/check-exported-parameter-names.mjs",
    "guide": "pnpm run links && pnpm run notation && pnpm run parameters",
    "routes": "node scripts/check-routes.mjs",
    "dev": "pnpm run api && vitepress dev",
    "build": "pnpm run api && vitepress build",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^5.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "vitepress": "^1.6.4"
  }
}
