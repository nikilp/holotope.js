{
  "$schema": "https://typedoc.org/schema.json",

  // Types borrowed from another package are outside this run, so their
  // routes come from what that package actually emitted. Generated by
  // scripts/link-packages.mjs; see there for why it is derived.
  "extends": ["./external-links.json"],
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "tsconfig": "../../packages/three/tsconfig.json",

  // Two entry points matching the two subpath exports. `webgpu` is kept
  // separate in package.json so WebGL-only consumers never pull it in; the
  // reference mirrors that split.
  "entryPoints": [
    "../../packages/three/src/index.ts",
    "../../packages/three/src/webgpu/index.ts"
  ],

  "out": "../api/three",

  // The model is also emitted so the documentation-coverage gate can
  // check the same data the reference is rendered from.
  "json": "../.doc-model/three.json",
  "docsRoot": "..",

  // Entry points are TypeScript sources rather than declaration output, so
  // the reference is generated from the same tree the tests run against and
  // does not depend on packages/*/dist existing or being current.
  "skipErrorChecking": true,
  "excludeExternals": true,
  "excludePrivate": true,
  "excludeInternal": true,
  // An unresolvable {@link} does not fail loudly: TypeDoc drops the link
  // and emits the bare name, losing even the code styling the backticks
  // gave it. That is worse than not having linked it, and invisible in
  // review, so the warning is made fatal.
  "treatWarningsAsErrors": true,

  "readme": "none",
  "githubPages": false,

  "useCodeBlocks": true,
  "expandObjects": true,
  "parametersFormat": "table",
  "propertiesFormat": "table",
  "enumMembersFormat": "table",
  "typeDeclarationFormat": "table",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,

  "sidebar": { "autoConfiguration": true, "format": "vitepress" }
}
